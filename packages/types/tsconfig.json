{
  // "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2020",
    "outDir": "dist",
    "rootDir": "types",
    "strict": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "declaration": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["types"],
  "exclude": ["node_modules", "dist"]
}
